CQA_API_URL=
DB_PATH=cqa.db
LLM_PROVIDER=gemini,groq
LLM_MODEL=
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=       # ключ API с console.anthropic.com (не подписка); LLM_PROVIDER=anthropic, LLM_MODEL=claude-haiku-5-5
LLM_RPM=5
LLM_CONCURRENCY=1
LLM_ALLOW_VOICE=
# true — отправлять в ИИ и звонки. Без этого ВСЕ звонки получают needs_review (только после разрешения организаторов)
# EVAL_MODE=single          # single | sections (запрос на секцию чек-листа)
# CRITICAL_RECHECK=false    # true — отдельная перепроверка грубых нарушений
# QUOTE_RETRY=true          # повтор, если цитаты yes/шкалы не найдены в тексте
# PROMPT_FACTS=true         # блок найденных кодом фактов перед транскриптом
